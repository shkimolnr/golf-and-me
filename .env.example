VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
# GA4는 GTM 없이 gtag.js로 직접 연결합니다. 실제 측정 ID는 저장소에 넣지 마세요.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# development, preview, production을 Vercel 환경별로 각각 명시합니다.
VITE_APP_ENV=development
VITE_ANALYTICS_ENV=development
# GA4 속성 설정과 DebugView 검증이 끝날 때까지 false를 유지합니다.
VITE_ANALYTICS_ENABLED=false
# Beta 테스트 계정 신청 폼. Slack Webhook 설정 전에는 false를 유지합니다.
VITE_TEST_ACCESS_REQUEST_ENABLED=false
# Vercel 서버 환경변수로만 설정합니다. VITE_ 접두사를 붙이지 마세요.
SLACK_TEST_ACCESS_WEBHOOK_URL=https://hooks.slack.com/services/...
# 의견 전용 채널이 없으면 테스트 계정 Webhook으로 임시 전달합니다.
SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/...
